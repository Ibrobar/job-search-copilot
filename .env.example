# Copy to .env (gitignored). In Azure these come from Key Vault / managed identity -- never commit real values.
DATABASE_URL=postgres://jsc:jsc@localhost:5432/jsc
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Local dev only; in Azure the app authenticates with managed identity (no key).
AZURE_OPENAI_API_KEY=
# LLM_MODE=mock uses recorded fixtures (CI default); LLM_MODE=live calls Azure OpenAI.
LLM_MODE=mock
